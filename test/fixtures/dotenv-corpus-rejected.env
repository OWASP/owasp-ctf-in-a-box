# The values scripts/lib/dotenv.sh REFUSES to read, run by
# scripts/test/dotenv.bats. Each `#! KEY|reason` line says dotenv_get must fail
# for KEY with a message containing `reason`, naming the key and the file but
# never the value.
#
# Every one of these is a value docker compose reads differently from a plain
# reader, or cannot read at all. Returning anything would make a script and the
# box disagree: an empty SCORE_IMAGE turns Secure Development OFF, and a
# literal `${SCORER_IMAGE:-}` turns it ON, while compose may do the opposite.
# So the reader fails, and the script stops with the reason.
#
# One value per line, and only the LAST assignment of a key is read, so an
# unterminated quote here cannot swallow the lines after it.

#! UNTERMINATED_DQ|unterminated quote
UNTERMINATED_DQ="ghcr.io/fixture/score:latest
#! UNTERMINATED_SQ|unterminated quote
UNTERMINATED_SQ='abc
#! LONE_DQ|unterminated quote
LONE_DQ="
#! BRACE_DEFAULT|uses interpolation
BRACE_DEFAULT=${SCORER_IMAGE:-}
#! BARE_NAME|uses interpolation
BARE_NAME=$SCORER_IMAGE
#! DQ_BRACE|uses interpolation
DQ_BRACE="${X}"
#! UNDERSCORE_NAME|uses interpolation
UNDERSCORE_NAME=$_x
#! EMBEDDED|uses interpolation
EMBEDDED=ghcr.io/${ORG}/score:latest
#! DOLLAR_ESCAPE|uses interpolation
DOLLAR_ESCAPE=pa$$word
#! DQ_ESCAPED_QUOTE|backslash escape
DQ_ESCAPED_QUOTE="a\"b"
#! DQ_NEWLINE|backslash escape
DQ_NEWLINE="a\nb"
#! SQ_ESCAPED_QUOTE|backslash escape
SQ_ESCAPED_QUOTE='Let\'s go!'
