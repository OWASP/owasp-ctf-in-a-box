# Shared .env corpus: every shell reader of an env file goes through
# scripts/lib/dotenv.sh, and scripts/test/dotenv.bats runs this file through it
# twice — as written (LF) and converted to CRLF — expecting identical results.
#
# Each `#> KEY|expected` line is an expectation: the value after the first `|`
# (possibly empty) is what `dotenv_get` must return for KEY. They were taken
# from `docker compose config` reading this same file, because the box runs
# compose and its reading is the one that decides which containers exist.
# The `#>` lines are comments to every reader, which is itself a case.

#> PLAIN|value
PLAIN=value
#> EMPTY|
EMPTY=
#> DQ_EMPTY|
DQ_EMPTY=""
#> SQ_EMPTY|
SQ_EMPTY=''
#> DQ|a b # not a comment
DQ="a b # not a comment"
#> SQ|single # quoted
SQ='single # quoted'
#> DQ_AFTER|quoted
DQ_AFTER="quoted" # trailing
#> EXPORTED|yes
export EXPORTED=yes
#> SPACED|spaced value
SPACED = spaced value
#> COLON|colon
COLON: colon
#> INLINE|value
INLINE=value # comment
#> HASH_IN_VALUE|https://host/#/route
HASH_IN_VALUE=https://host/#/route
#> LEADING_HASH|#notacomment
LEADING_HASH=#notacomment
#> EMPTY_COMMENT|# comment
EMPTY_COMMENT= # comment
#> DUP|second
DUP=first
DUP=second
#> INDENTED|x
   INDENTED=x
#> TRAILING|value
TRAILING=value   
#> COMMENTED|
# COMMENTED=foo
#> ABSENT|

# The key every entry point branches on: empty means Secure Development OFF.
# A prefix-sharing key must not leak into it.
#> SCORE_IMAGE|
SCORE_IMAGE=""
#> SCORE_IMAGE_EXTRA|ghcr.io/not/this:one
SCORE_IMAGE_EXTRA=ghcr.io/not/this:one
#> SECDEV_ON|ghcr.io/fixture/score:latest
SECDEV_ON="ghcr.io/fixture/score:latest"
#> TABBED|tabval	# tc
TABBED=	tabval	# tc

# A `$` that docker compose leaves literal is literal here too: in single
# quotes, and wherever it does not start a name or a `{`. Every `$` compose
# WOULD interpolate is rejected instead — see dotenv-corpus-rejected.env.
#> SQ_DOLLAR|$x
SQ_DOLLAR='$x'
#> SQ_BRACE|${X}
SQ_BRACE='${X}'
#> DOLLAR_DIGIT|pa$5word
DOLLAR_DIGIT=pa$5word
#> DOLLAR_END|a$
DOLLAR_END=a$
#> DOLLAR_DASH|a$-b
DOLLAR_DASH=a$-b
#> DOLLAR_SPACED|a $ b
DOLLAR_SPACED=a $ b
#> UNQUOTED_BACKSLASH|a\nb
UNQUOTED_BACKSLASH=a\nb

# The LAST assignment wins even when it is empty: an earlier value must not
# show through an emptied one.
#> DUP_LAST_EMPTY|
DUP_LAST_EMPTY=ghcr.io/fixture/score:latest
DUP_LAST_EMPTY=
#> DUP_LAST_QEMPTY|
DUP_LAST_QEMPTY=ghcr.io/fixture/score:latest
DUP_LAST_QEMPTY=""
# A backslash in single quotes is literal, except before a quote.
#> SQ_BACKSLASH|a\b
SQ_BACKSLASH='a\b'
