node_modules/
# Every env file, present and future. Listing them one by one is what let
# `.env.fly` — written by deploy/fly/deploy.sh init and holding the OAuth
# client secret, the GitHub App private key and the session signing key — get
# committed to a PUBLIC repo: a new tool invented a new filename, and no rule
# covered it. A glob cannot be outrun by the next one.
.env*
!.env.example
# Nothing reads event.yaml any more. Config v2 (#386) made `.env` plus /admin
# the whole config plane, and its last part removed the final readers — the Fly
# and AWS deploy scripts' config bake. The patterns stay ignored anyway,
# because an upgraded checkout still has the files on disk: `event.yaml` and
# `event.yaml.example` were both deleted from the repo, so without these lines
# a leftover copy would either be committable by accident or sit in
# `git status` as untracked forever. The glob also covers the `.old` and
# `.retired-*` names an organizer renames their own copy to.
event.yaml
event.yaml.*
# Anchored to the repo root on purpose: an unanchored `state/` also swallows
# source directories (apps/web/src/app/api/ai/state/ was force-added past it).
/state/

# internal planning docs — keep local, never commit
docs/superpowers/
# local audit reports — docs/ is the Jekyll root, so tracking them would publish them
docs/REVIEW.md
docs/hygiene-audit.md
# SDD execution scratch (ledgers, briefs, review packages) — keep local
.superpowers/

# Jekyll build destination (Pages workflow)
docs/_site/

# organizer's private rubric (built into their scorer image, never committed)
scorer/rubric/

# rendered per-event artifacts (ctf-setup.sh org/render writes dist/workflows/)
dist/

# vendored app build artifacts
apps/web/node_modules/
apps/web/.next/
apps/web/.env.local

# Local worktrees for parallel branch work (never committed)
.worktrees/

# Generated by deploy/fly/render-compose.sh from docker-compose.yml.
/compose.fly.yml
deploy/fly/.fly.autostop.toml
deploy/fly/.fly.vm.toml
