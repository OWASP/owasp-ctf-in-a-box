#!/usr/bin/env bash
# scripts/dev-stack — one-command local dev stack: click through the real
# contestant experience (leaderboard, challenge browsing, a score landing on
# the board) with no GitHub org, no OAuth app, no real contestant PRs.
#
# Subcommands:
#   up                          bring the stack up, seed a demo leaderboard
#   down [--wipe]                tear it down (--wipe also drops volumes)
#   score <login> <target> <n>   mark the first <n> catalogue challenges for
#                                 <target> solved for <login> (real scorer API)
#
# Reuses the same compose/SRH patterns as scripts/smoke.sh, but drives the
# real scorer's bearer-authed POST /score instead of writing Redis keys
# directly — see the note above submit_solves() for why.
#
# Needs NO config file (config v2, #386): `ADMIN_LOGINS` and `GITHUB_ORG` are
# runtime keys resolved from the environment or `.env`, nothing is baked into
# the app image, and everything else — the event's name, which modules run,
# which Secure Development targets — is an `/admin` setting.
set -euo pipefail
cd "$(dirname "$0")/.."

SCORER_IMAGE_TAG="ctf-dev-stack/scorer:local"
DEV_ENV_FILE=.env.dev-stack

# ---------------------------------------------------------------------------
# env resolution — never overwrite a real .env; a throwaway file only.
# ---------------------------------------------------------------------------
ENV_FILE=""

resolve_env_file() {
  if [ -f .env ]; then
    ENV_FILE=.env
  elif [ -f "$DEV_ENV_FILE" ]; then
    ENV_FILE="$DEV_ENV_FILE"
  else
    ENV_FILE=""
  fi
}

# Strip a trailing annotation and whitespace off an env value: a real .env may
# read `GITHUB_ORG=myorg  # the disposable one`, the same shape
# setup/ctf-setup.sh's reader tolerates. Only a `#` AFTER whitespace starts a
# comment — `EVENT_URL=https://host/#/route` keeps its fragment, which is
# also how compose reads the file.
strip_comment() {
  printf '%s' "$1" | sed -e 's/[[:space:]][[:space:]]*#.*$//' -e 's/[[:space:]]*$//'
}

# Read one KEY=value out of a named env file (BSD/GNU-safe sed, no -E). A
# missing file is not an error — every caller has a fallback for "not set".
file_value() {
  local key="$1" file="$2" v
  if [ -z "$file" ] || [ ! -f "$file" ]; then
    return 0
  fi
  v="$(sed -n "s/^${key}=//p" "$file" | tail -1)"
  strip_comment "$v"
}

# ADMIN_LOGINS and GITHUB_ORG are RUNTIME keys since config v2 (#386) — there
# is no config file to derive them from any more, and nothing is baked into
# the image. Resolve them the way the containers will actually see them:
# docker compose lets the shell environment win over --env-file, so an
# exported value is authoritative, then the env file, then a last resort.
#
# ADMIN_LOGINS falls back to the login `gh` is authenticated as — the same
# default the setup wizard offers (setup/ctf-setup.sh's wiz_event_basics) —
# and only when `gh` is both installed and logged in, so a box without it just
# gets an empty allowlist. Empty is not fatal here: the stack still runs and
# /admin forbids everyone, which the summary says, and how to fix it.
#
# `${VAR+x}`, not `${VAR:-}`: compose gives the shell precedence over the env
# file, so an EXPORTED empty value is exactly what the containers get and
# must not be papered over with the file's (or gh's) value — only an unset
# variable falls through. Otherwise the file this writes and the summary
# below could name an allowlist the app is not using.
resolve_admin_logins() {
  local v
  if [ "${ADMIN_LOGINS+x}" = x ]; then
    v="$ADMIN_LOGINS"
  else
    v="$(file_value ADMIN_LOGINS .env)"
    if [ -z "$v" ]; then
      if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
        v="$(gh api user --jq .login 2>/dev/null || true)"
      fi
    fi
  fi
  printf '%s' "$v"
}

# No fallback for the org: an invented one would put wrong fork links on
# /challenges. Empty means the app shows bare repo names. Same unset-vs-empty
# rule as above.
resolve_github_org() {
  local v
  if [ "${GITHUB_ORG+x}" = x ]; then
    v="$GITHUB_ORG"
  else
    v="$(file_value GITHUB_ORG .env)"
  fi
  printf '%s' "$v"
}

ensure_env() {
  resolve_env_file
  if [ -n "$ENV_FILE" ]; then
    echo "== using existing $ENV_FILE"
    # An env file written before Redis grew a password is the common case on
    # a machine that has run this kit before. Compose would fail on the `:?`
    # with a message about a variable, which is accurate but does not say
    # what to do. Say it here instead, and do not edit the file — it may be
    # the organizer's real .env.
    if ! grep -q "^REDIS_PASSWORD=." "$ENV_FILE"; then
      echo "FAIL: $ENV_FILE has no REDIS_PASSWORD (Redis now requires one)." >&2
      echo "      Add a line like this and re-run:" >&2
      echo "" >&2
      echo "      REDIS_PASSWORD=$(openssl rand -hex 24)" >&2
      echo "" >&2
      exit 1
    fi
    return
  fi
  echo "== no .env found; writing a throwaway $DEV_ENV_FILE (same fields as setup/ctf-setup.sh secrets)"
  # ADMIN_LOGINS/GITHUB_ORG are runtime keys, so the throwaway file wants real
  # values rather than blanks — resolved from the environment (or `gh`, for the
  # admin login) by the helpers above.
  local admin_logins github_org
  admin_logins="$(resolve_admin_logins)"
  github_org="$(resolve_github_org)"
  {
    echo "# generated by scripts/dev-stack — throwaway local secrets, do not use for a real event"
    echo "BETTER_AUTH_SECRET=$(openssl rand -base64 32 | tr -d '\n')"
    echo "SRH_TOKEN=$(openssl rand -hex 24)"
    echo "SCORER_TOKEN=$(openssl rand -hex 24)"
    echo "REDIS_PASSWORD=$(openssl rand -hex 24)"
    echo "GITHUB_CLIENT_ID="
    echo "GITHUB_CLIENT_SECRET="
    echo "GITHUB_APP_ID="
    echo "GITHUB_APP_PRIVATE_KEY="
    echo "GITHUB_APP_INSTALLATION_ID="
    echo "EVENT_URL=http://localhost"
    echo "SCORE_IMAGE="
    echo "ADMIN_LOGINS=$admin_logins"
    echo "GITHUB_ORG=$github_org"
  } > "$DEV_ENV_FILE"
  ENV_FILE="$DEV_ENV_FILE"
}

# Read one KEY=value out of the RESOLVED env file, with a default.
env_value() {
  local key="$1" default="${2:-}" v
  v="$(file_value "$key" "$ENV_FILE")"
  echo "${v:-$default}"
}

# Does this stack run Secure Development? One answer, from one key: a
# non-empty SCORE_IMAGE (config v2, #386). Exported wins over the env file,
# exactly as compose resolves it — an exported EMPTY value included, so it
# branches on `${VAR+x}` like the resolvers above rather than `${VAR:-}`.
# cmd_up builds a local scorer image and exports the tag, so `up` always has
# it.
secdev_enabled() {
  local score_image
  if [ "${SCORE_IMAGE+x}" = x ]; then
    score_image="$SCORE_IMAGE"
  else
    score_image="$(env_value SCORE_IMAGE)"
  fi
  [ -n "$score_image" ]
}

# `app` is always on; `secdev` (the scorer and sync containers) is added iff
# SCORE_IMAGE is non-empty, which is how every other entry point derives it —
# see deploy/fly/render-compose.sh and docker-compose.yml's scorer comment.
compose() {
  local -a profiles
  profiles=(--profile app)
  if secdev_enabled; then
    profiles+=(--profile secdev)
  fi
  docker compose --env-file "$ENV_FILE" -f docker-compose.yml "${profiles[@]}" "$@"
}

# ---------------------------------------------------------------------------
# challenge catalogues — a curated slice of scorer/rubric.owasp/*/tests/
# challenges/catalogue.<target>.json ids, enough to seed a believable board.
# Hardcoded (not read live from the JSON at runtime) so this script has no jq
# / node / python dependency on the host — only docker, curl, openssl, sed.
# ---------------------------------------------------------------------------
JUICE_SHOP_IDS=(
  challenge-12-security-through-obscurity
  challenge-59-outdated-allowlist
  challenge-1-password-hash-leak
  challenge-16-nautical-mystery
  challenge-45-login-admin
  challenge-5-admin-section
  challenge-66-reflected-xss
  challenge-10-mint-the-honey-pot
)
DVWA_IDS=(
  challenge-1-brute-force-low
  challenge-2-command-injection-low
  challenge-3-csrf-low
  challenge-4-file-inclusion-low
  challenge-5-file-upload-low
  challenge-6-insecure-captcha-low
  challenge-7-sql-injection-low
  challenge-8-sql-injection-blind-low
)

challenge_ids_json() {
  local target="$1" count="$2" arr=() i out="[" n
  case "$target" in
    juice-shop) arr=("${JUICE_SHOP_IDS[@]}") ;;
    dvwa) arr=("${DVWA_IDS[@]}") ;;
    *)
      echo "dev-stack: unsupported target '$target' (this demo seeds juice-shop or dvwa only)" >&2
      return 1
      ;;
  esac
  n=${#arr[@]}
  [ "$count" -gt "$n" ] && count=$n
  [ "$count" -lt 1 ] && { echo "dev-stack: <n> must be >= 1" >&2; return 1; }
  for ((i = 0; i < count; i++)); do
    [ "$i" -gt 0 ] && out+=","
    out+="\"${arr[$i]}\""
  done
  out+="]"
  echo "$out"
}

# Writes a fake solve straight through the real scorer's bearer-authed
# POST /score — the same endpoint a contestant's scoring Action calls in push
# mode (scorer/src/serve.js). We run the request *inside* the scorer
# container (docker compose exec + node's built-in fetch) rather than
# publishing a host port for it or reaching into Redis ourselves: the scorer
# already holds CTF_SCORE_BEARER_TOKEN and the SRH connection, so this is the
# smallest, most honest way to seed — it exercises the identical validation
# and Redis-write path a real scored PR would.
#
# Note on schema: the app's LEADERBOARD_SOURCE is "lambda" in docker-compose.yml,
# which reads scorer's HTTP /leaderboard (backed by ctf:solves:<target> hashes),
# NOT the ZADD leaderboard / HSET team:<login> zset+hash schema. That schema
# belongs to LEADERBOARD_SOURCE=upstash, written by a different, external
# pusher (see apps/web/src/lib/leaderboard/upstash.ts's own comment) that this
# repo's scorer does not implement. Seeding through the real /score endpoint
# is what actually renders under the compose file as shipped.
submit_solves() {
  local login="$1" target="$2" count="$3" ids_json status n
  case "$target" in
    juice-shop) n=${#JUICE_SHOP_IDS[@]} ;;
    dvwa) n=${#DVWA_IDS[@]} ;;
    *)
      echo "dev-stack: unsupported target '$target' (this demo seeds juice-shop or dvwa only)" >&2
      return 1
      ;;
  esac
  [ "$count" -gt "$n" ] && count=$n
  ids_json="$(challenge_ids_json "$target" "$count")" || return 1
  status="$(compose exec -T \
    -e CTF_LOGIN="$login" -e CTF_TARGET="$target" -e CTF_IDS_JSON="$ids_json" \
    scorer node -e '
      fetch("http://localhost:4000/score", {
        method: "POST",
        headers: { authorization: "Bearer " + process.env.CTF_SCORE_BEARER_TOKEN, "content-type": "application/json" },
        body: JSON.stringify({
          author: process.env.CTF_LOGIN,
          target: process.env.CTF_TARGET,
          solved: JSON.parse(process.env.CTF_IDS_JSON),
        }),
      }).then(async (r) => {
        if (!r.ok) { console.error(await r.text()); process.exit(1); }
        process.stdout.write(String(r.status));
      }).catch((err) => { console.error(String(err)); process.exit(1); });
    ')"
  echo "   $login / $target: submitted $count solve(s) -> HTTP $status"
}

seed_demo_data() {
  echo "== seeding demo leaderboard data (real POST /score, rubric-priced)"
  submit_solves alice-dev juice-shop 6
  submit_solves alice-dev dvwa 4
  submit_solves bob-dev juice-shop 3
  submit_solves carol-dev dvwa 5
  submit_solves mallory-dev juice-shop 1
}

# ---------------------------------------------------------------------------
# readiness waits — same shape as scripts/smoke.sh: poll with a $SECONDS
# deadline, print logs and fail loudly on timeout.
# ---------------------------------------------------------------------------
wait_for_redis() {
  echo "== waiting for redis"
  local deadline=$((SECONDS + 30))
  until compose exec -T redis redis-cli ping 2>/dev/null | grep -q PONG; do
    [ "$SECONDS" -ge "$deadline" ] && { echo "FAIL: redis never answered"; compose logs redis; exit 1; }
    sleep 1
  done
}

wait_for_scorer() {
  echo "== waiting for scorer /healthz"
  local deadline=$((SECONDS + 60))
  until compose exec -T scorer node -e '
      fetch("http://localhost:4000/healthz").then((r) => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1));
    ' >/dev/null 2>&1; do
    [ "$SECONDS" -ge "$deadline" ] && { echo "FAIL: scorer never became healthy"; compose logs scorer; exit 1; }
    sleep 1
  done
}

wait_for_app() {
  local url="$1"
  echo "== waiting for app at $url"
  local deadline=$((SECONDS + 90))
  until curl -sf -o /dev/null "$url/"; do
    [ "$SECONDS" -ge "$deadline" ] && { echo "FAIL: app never answered at $url"; compose logs app caddy; exit 1; }
    sleep 2
  done
}

# ---------------------------------------------------------------------------
# subcommands
# ---------------------------------------------------------------------------
cmd_up() {
  ensure_env
  echo "== building scorer image locally from scorer/ (default rubric.owasp)"
  docker build -q -t "$SCORER_IMAGE_TAG" ./scorer >/dev/null
  export SCORE_IMAGE="$SCORER_IMAGE_TAG"

  # Nothing to bake: the app reads ADMIN_LOGINS and GITHUB_ORG from its
  # environment at start-up (config v2, #386), so the image is config-free and
  # a changed value needs a restart, not a rebuild.

  # Build stamp for GET /health, so a local stack reports the same fields
  # production does. The sha is deliberately left empty rather than faked: a
  # dev stack is built from a working tree that is almost never clean, and
  # /health reporting a commit that does not describe the image is worse than
  # it reporting "unknown".
  export APP_BUILD_REV APP_BUILT_AT
  APP_BUILD_REV=""
  APP_BUILT_AT="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

  echo "== bringing up redis, srh, scorer, app, caddy"
  compose up -d --build redis srh scorer app caddy

  wait_for_redis
  wait_for_scorer
  local event_url
  event_url="$(env_value EVENT_URL http://localhost)"
  wait_for_app "$event_url"

  seed_demo_data

  # What the CONTAINERS got, in their precedence order — an exported value
  # (even an empty one) beats the env file for compose, so reading the file
  # alone could print an allowlist the app is not using.
  local admins org org_note profiles
  if [ "${ADMIN_LOGINS+x}" = x ]; then admins="$ADMIN_LOGINS"; else admins="$(env_value ADMIN_LOGINS)"; fi
  if [ "${GITHUB_ORG+x}" = x ]; then org="$GITHUB_ORG"; else org="$(env_value GITHUB_ORG)"; fi
  if [ -n "$org" ]; then
    org_note="$org (fork links on /challenges point there)"
  else
    org_note="<none set> — /challenges shows bare repo names, no fork links"
  fi
  # Which profiles this bring-up actually used, and why — the derivation is
  # SCORE_IMAGE and nothing else.
  #
  # Names the CONTAINERS, not the profile's full membership: `up` starts
  # redis, srh, scorer, app and caddy by name and deliberately leaves `sync`
  # out — polling needs a real GitHub org and App credentials, which a dev
  # stack has not got. Saying "scorer + sync run" sent people looking for a
  # poller container that was never started.
  if secdev_enabled; then
    profiles="app, secdev (SCORE_IMAGE is set, so the scorer runs; sync is not started — no GitHub org to poll)"
  else
    profiles="app (SCORE_IMAGE is empty, so no scorer and no sync)"
  fi

  cat <<SUMMARY

============================================================
 dev-stack is up
============================================================
 Open:            $event_url
 Leaderboard:     $event_url/leaderboard
 Env file:        $ENV_FILE (no config file: every setting is .env or /admin)
 Profiles:        $profiles
 GITHUB_ORG:      $org_note

 Seeded demo players (real scorer POST /score, so this is the same
 code path a scored PR uses): alice-dev, bob-dev, carol-dev, mallory-dev.
 The board's fetch cache revalidates every 30s, so give it a few seconds
 if a fresh load still shows the old numbers.

 Watch a NEW score land live:
   ./scripts/dev-stack score <login> <juice-shop|dvwa> <n>
   (marks the first <n> catalogue challenges solved for <login>; reload
   $event_url/leaderboard after ~30s)

 Admin panel / signed-in experience (NOT available out of the box):
   /admin requires a signed-in session whose GitHub login is in
   $ENV_FILE's ADMIN_LOGINS (currently: ${admins:-<none set>}), and
   sign-in requires a real GitHub OAuth app. This script does not fake
   or bypass that boundary. To exercise it:
     1. Create a GitHub OAuth app, callback <EVENT_URL>/api/auth/callback/github.
     2. Put its client id/secret into $ENV_FILE (GITHUB_CLIENT_ID / GITHUB_CLIENT_SECRET).
     3. Put your GitHub login into $ENV_FILE's ADMIN_LOGINS (comma-separated).
        An EXPORTED ADMIN_LOGINS overrides the file (that is compose's
        precedence, and the value shown above is what the app got), so unset
        it or export the new list before the next step.
     4. ./scripts/dev-stack down && ./scripts/dev-stack up   (restarts and picks
        up the new .env; no rebuild needed — ADMIN_LOGINS is read at start)
   Everything else — leaderboard, challenge browsing, seeded scores — works now.

 Tear down: ./scripts/dev-stack down            (keeps seeded state)
            ./scripts/dev-stack down --wipe      (also drops volumes)
============================================================
SUMMARY
}

cmd_down() {
  resolve_env_file
  if [ -z "$ENV_FILE" ]; then
    # No secrets needed to tear down; compose only needs the project name,
    # which comes from the directory, not the env file.
    ENV_FILE=/dev/null
  fi
  if [ "${1:-}" = "--wipe" ]; then
    compose down -v --remove-orphans
    echo "stack down, volumes wiped"
  else
    compose down --remove-orphans
    echo "stack down (seeded data preserved in the redis-data volume; use 'down --wipe' to clear it)"
  fi
}

cmd_score() {
  [ $# -eq 3 ] || { echo "usage: dev-stack score <login> <juice-shop|dvwa> <n>" >&2; exit 2; }
  resolve_env_file
  [ -n "$ENV_FILE" ] || { echo "no .env or $DEV_ENV_FILE found — run 'dev-stack up' first" >&2; exit 1; }
  submit_solves "$1" "$2" "$3"
}

case "${1:-}" in
  up|"") cmd_up ;;
  down) shift; cmd_down "$@" ;;
  score) shift; cmd_score "$@" ;;
  *)
    echo "usage: dev-stack {up|down [--wipe]|score <login> <juice-shop|dvwa> <n>}" >&2
    exit 2
    ;;
esac
